    },
    {
      "id": "recorder",
      "label": "SimpleAgent recorder",
      "kind": "contract",
      "status": "proposed",
      "summary": "One call. One durable exchange.",
      "detail": "Owns persistent identity and journal identity. Prepares an attempt before contact, captures bounded sanitized provider content, confirms persistence, and returns None. Not located as an implemented unit.",
      "evidence": []
    },
    {
      "id": "endpoint",
      "label": "Configured endpoint",
      "kind": "contract",
      "status": "proposed",
      "summary": "One configured inference source",
      "detail": "Provider-native, non-streaming text/JSON transport. No inserted persona, tool loop, automatic inference retry, or universal model/messages requirement.",
      "evidence": []
    },
    {
      "id": "outbox",
      "label": "Durable outbox",
      "kind": "contract",
      "status": "proposed",
      "summary": "Retain accepted evidence",
      "detail": "Sanitized final updates survive persistence failure. Replay storage writes only. Refuse intake at capacity, report corruption, and never silently discard accepted records.",
      "evidence": []
    },
    {
      "id": "store",
      "label": "Dedicated journal",
      "kind": "contract",
      "status": "proposed",
      "summary": "Request / response / notes / metadata",
      "detail": "Dedicated PocketBase ownership with guarded finalization and unique request_id. Capture state, provenance, uncertainty, and unstructured text notes separately.",
      "evidence": []
    },
    {
